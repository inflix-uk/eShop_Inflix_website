# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# sitemap CLI/API artifact (live sitemap is src/app/sitemap.ts → /sitemap.xml)
sitemap.generated.xml

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Environment variables & secrets (all common variants — do not commit)
# Covers: .env, .env.local, .env.*, .env.development(.local), .env.production(.local), etc.
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc
.direnv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

