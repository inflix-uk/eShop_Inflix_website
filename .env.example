# Copy to `.env.local` for local development. Restart `next dev` after changes.

# No trailing slash — the app joins paths as `${NEXT_PUBLIC_API_URL}/your-endpoint`.
# Required for /robots.txt and most CMS data. On Vercel, set at build time and redeploy after changes.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-only fallback for /robots.txt and SSR if NEXT_PUBLIC_* was not set at build (optional).
# API_URL=https://api.example.com
# Used as fallback for absolute URLs when request Host is missing (e.g. some JSON-LD helpers). Product canonical + og:url use the actual request host (self-referencing).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional override for env-only URLs (no trailing slash). Production often sets both to https://www.aromadesire.com
# NEXT_PUBLIC_SITE_URL=https://www.aromadesire.com

NEXT_PUBLIC_SITEMAP_STORE_DOMAIN=www.aromadesire.com